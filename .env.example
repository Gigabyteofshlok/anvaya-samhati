# ANVAYA SAMHATI — Environment Configuration

# Application
APP_NAME="ANVAYA SAMHATI"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=replace-with-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL Required)
DATABASE_URL=postgresql+psycopg2://USERNAME:PASSWORD@127.0.0.1:5432/anvaya_db

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
